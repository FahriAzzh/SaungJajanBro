@page
@model IndexModel
@{
    ViewData["Title"] = "SaungJajan";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&family=Nunito:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Nunito', sans-serif;
            background-color: #ffffff;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 20px;
        }

        .landing-container {
            width: 100%;
            max-width: 440px;
            text-align: center;
            padding: 10px;
        }

        .brand-title {
            font-family: 'Fredoka', sans-serif;
            font-weight: 700;
            font-size: 3.2rem;
            color: #000000;
            margin-bottom: 5px;
            letter-spacing: -0.5px;
        }

        .brand-subtitle {
            font-size: 1.4rem;
            color: #000000;
            font-weight: 700;
            margin-bottom: 50px;
            line-height: 1.3;
        }

        .btn-custom {
            background-color: #7675ee !important;
            border: none !important;
            border-radius: 50px !important;
            padding: 14px 25px !important;
            font-size: 1.3rem !important;
            font-weight: 700;
            color: #000000 !important;
            transition: all 0.2s ease-in-out;
            width: 100%;
            margin-bottom: 15px;
        }

        .btn-custom:hover {
            background-color: #6362dc !important;
            opacity: 0.95;
        }

        .btn-custom:active {
            transform: scale(0.98);
        }

        .btn-toko {
            background-color: #28a745 !important;
            color: #ffffff !important;
        }

        .btn-toko:hover {
            background-color: #218838 !important;
        }

        .divider {
            margin: 25px 0;
            position: relative;
            text-align: center;
        }

        .divider::before {
            content: '';
            position: absolute;
            left: 0;
            top: 50%;
            width: 100%;
            height: 1px;
            background: #dee2e6;
        }

        .divider span {
            background: white;
            padding: 0 15px;
            position: relative;
            color: #6c757d;
            font-size: 0.9rem;
        }

        .info-text {
            color: #6c757d;
            font-size: 0.9rem;
            margin-top: 20px;
        }

        /* Responsive Optimization */
        @@media (max-width: 576px) {
            .brand-title {
                font-size: 2.8rem;
            }
            .brand-subtitle {
                font-size: 1.15rem;
                margin-bottom: 40px;
            }
            .btn-custom {
                padding: 12px 20px !important;
                font-size: 1.2rem !important;
            }
        }
    </style>
</head>
<body>

    <div class="landing-container">
        <h1 class="brand-title">SaungJajan</h1>
        <p class="brand-subtitle">Pilih metode login untuk melanjutkan.</p>

        <form>
            <div class="d-grid">
                <a asp-page="/Auth/Login" class="btn btn-custom">
                    Masuk sebagai Pembeli
                </a>
            </div>

            <div class="divider">
                <span>atau</span>
            </div>

            <div class="d-grid">
                <a asp-page="/Auth/LoginToko" class="btn btn-custom btn-toko">
                    Masuk sebagai Penjual
                </a>
            </div>
        </form>

        <div class="info-text">
            Hubungi admin untuk pembuatan akun pembeli
        </div>
    </div>

</body>
</html>