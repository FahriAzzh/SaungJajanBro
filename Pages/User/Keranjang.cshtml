@page
@model SAUNGJAJAN.Pages.User.KeranjangModel
@{
    ViewData["Title"] = "Keranjang";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SaungJajan</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Nunito', sans-serif;
            background-color: #1f1f1f;
        }
        .font-fredoka {
            font-family: 'Fredoka', sans-serif;
        }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="p-0 md:p-6 lg:p-8 flex items-center justify-center min-h-screen">

    <div class="main-container w-full max-w-[450px] lg:max-w-[1000px] bg-white min-h-screen lg:min-h-[780px] lg:rounded-[40px] shadow-2xl overflow-hidden p-6 md:p-8 flex flex-col justify-between border-0 md:border-[8px] border-slate-800 transition-all duration-300">
        
        <div>
            <div class="flex flex-col md:flex-row justify-between items-center pb-4 mb-6 border-b border-slate-100 gap-4">
                <a class="font-fredoka font-bold text-4xl text-black hover:opacity-85 transition-opacity" asp-page="/User/Menu">
                    Saung Jajan
                </a>

                <ul class="flex items-center gap-8 m-0 p-0 list-none">
                    <li>
                        <a asp-page="/User/Menu" class="text-xl font-bold text-black underline underline-offset-[6px] decoration-[2.5px] hover:text-[#7675ee] transition-colors">
                            Home
                        </a>
                    </li>
                    <li>
                        <a asp-page="/User/LogPesanan" class="text-xl font-bold text-black underline underline-offset-[6px] decoration-[2.5px] hover:text-[#7675ee] transition-colors">
                            Log
                        </a>
                    </li>
                    <li>
                        <a asp-page="/User/Keranjang" class="inline-flex items-center text-black hover:text-[#7675ee] hover:scale-108 transition-all" title="Lihat Keranjang Belanja">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .49.598l-1 5a.5.5 0 0 1-.465.401l-9.397.472L4.415 11H13a.5.5 0 0 1 0 1H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5M3.102 4l.84 4.479 9.144-.459L13.89 4zM5 12a1 1 0 1 0 0 2 1 1 0 0 0 0 -2m7 0a1 1 0 1 0 0 2 1 1 0 0 0 0 -2"/>
                            </svg>
                        </a>
                    </li>
                </ul>

                <div class="flex items-center gap-3">
                    <div class="bg-[#f1f1f5] border border-[#e2e2ea] rounded-xl p-2.5 flex items-center gap-3 w-full md:w-auto max-w-[260px]">
                        <div class="bg-white text-[#7675ee] rounded-lg w-9 h-9 flex items-center justify-center shadow-sm flex-shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M12.136.326A1.5 1.5 0 0 1 14 1.78V3h.5A1.5 1.5 0 0 1 16 4.5v9a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 0 13.5v-9A1.5 1.5 0 0 1 1.5 3H2V1.78a1.5 1.5 0 0 1 1.864-1.454zM3 3h9v-.191A.5.5 0 0 0 11.378 2.34L3 3zm11 1.5h-11v9h11z"/>
                            </svg>
                        </div>
                        <div class="flex flex-col text-left line-content-tight">
                            <span class="text-[0.95rem] font-bold text-[#111111]">@Model.UserNama</span>
                            <span class="text-[0.75rem] font-bold text-[#666666] uppercase tracking-wide">Saldo Anda</span>
                            <span class="text-[1.05rem] font-bold text-black">Rp @Model.UserSaldo.ToString("N0")</span>
                        </div>
                    </div>

                    <a asp-page="/Auth/Logout" class="bg-[#dc3545] hover:bg-[#c82333] text-white font-bold px-4 py-2.5 rounded-xl text-sm shadow-sm transition-all flex items-center gap-2 flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 2h-8A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0v2z"/>
                            <path fill-rule="evenodd" d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708l3-3z"/>
                        </svg>
                        <span class="hidden lg:inline">Logout</span>
                    </a>
                </div>
            </div>

            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
                <div>
                    <h2 class="font-fredoka text-3xl lg:text-4xl font-bold text-black">Keranjang</h2>
                </div>
                <div class="flex gap-3 w-full sm:w-auto justify-end">
                    <a asp-page="/User/Menu" class="bg-[#9492ff] hover:bg-[#5b59e0] text-black hover:text-white font-bold px-5 py-2.5 rounded-2xl text-sm lg:text-base shadow-sm transition-all border border-black/5 text-center flex-1 sm:flex-none">
                        Kembali ke Menu
                    </a>
                    <a asp-page="/User/LogPesanan" class="bg-[#ff7e79] hover:bg-red-500 text-black hover:text-white font-bold px-5 py-2.5 rounded-2xl text-sm lg:text-base shadow-sm transition-all border border-black/5 text-center flex-1 sm:flex-none">
                        Log Pesanan
                    </a>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
            {
                <div class="mb-4 rounded-xl bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700 ring-1 ring-emerald-200">@Model.SuccessMessage</div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="mb-4 rounded-xl bg-red-50 px-4 py-3 text-sm font-medium text-red-700 ring-1 ring-red-200">@Model.ErrorMessage</div>
            }

            @if (!Model.KeranjangTokoList.Any())
            {
                <div class="alert alert-warning bg-yellow-50 border border-yellow-200 rounded-xl px-4 py-3 text-sm font-medium text-yellow-700">
                    Keranjang masih kosong.
                </div>
            }
            else
            {
                <form method="post" id="checkoutForm" asp-page-handler="CheckoutSelected"></form>

                @foreach (var toko in Model.KeranjangTokoList)
                {
                    <div class="border-2 border-slate-300 rounded-[24px] p-3 sm:p-5 bg-white mb-6 shadow-sm">
                        
                        <div class="border-2 border-slate-300 rounded-xl p-3 mb-4 text-xl lg:text-2xl font-bold text-black font-fredoka">
                            @toko.NamaToko
                        </div>

                        <div class="overflow-x-auto no-scrollbar">
                            <table class="w-full text-left border-collapse min-w-[650px] text-base lg:text-lg font-bold text-black">
                                <thead>
                                    <tr class="text-center text-black border-b border-slate-200">
                                        <th class="py-3 px-2 w-16">Pilih</th>
                                        <th class="py-3 px-2 text-left">Produk</th>
                                        <th class="py-3 px-2">Harga</th>
                                        <th class="py-3 px-2">Stok</th>
                                        <th class="py-3 px-2 w-28">Qty</th>
                                        <th class="py-3 px-2">Subtotal</th>
                                        <th class="py-3 px-2">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    @foreach (var item in toko.Detail)
                                    {
                                        <tr class="align-middle">
                                            <td class="py-4 px-2 text-center">
                                                <input type="checkbox" form="checkoutForm" name="selectedKeranjangIds" value="@item.IdKeranjang" class="w-6 h-6 rounded border-slate-400 text-[#7371fc] focus:ring-[#7371fc]" />
                                            </td>
                                            <td class="py-4 px-2">@item.NamaProduk</td>
                                            <td class="py-4 px-2 text-center">Rp @item.Harga.ToString("N0")</td>
                                            <td class="py-4 px-2 text-center text-slate-700">@item.Stok</td>
                                            <td class="py-4 px-2 text-center">
                                                <input type="number" form="checkoutForm" name="quantityUpdates[@item.IdKeranjang]" value="@item.Quantity" min="1" max="@item.Stok" class="w-full bg-white border border-slate-400 rounded-md py-1 px-2 text-center focus:outline-none focus:ring-2 focus:ring-[#7371fc]" />
                                            </td>
                                            <td class="py-4 px-2 text-center">Rp. @item.Subtotal.ToString("N0")</td>
                                            <td class="py-4 px-2 text-center">
                                                <form method="post" asp-page-handler="Remove" onsubmit="return confirm('Hapus produk ini dari keranjang?');" class="inline">
                                                    <input type="hidden" name="idKeranjang" value="@item.IdKeranjang" />
                                                    <button type="submit" class="bg-[#ff2e2e] hover:bg-red-700 text-white font-bold px-4 py-1.5 rounded-lg text-sm transition-colors shadow-sm">
                                                        Hapus
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="mt-4 border-2 border-slate-300 rounded-xl p-3 flex justify-end gap-2 text-lg lg:text-xl font-bold text-black font-fredoka">
                            <span>Total Toko:</span>
                            <span class="text-right min-w-[120px]">Rp. @toko.TotalHarga.ToString("N0")</span>
                        </div>

                    </div>
                }

                <div class="bg-[#e6f9f3] border-2 border-[#ccf2e6] rounded-[24px] p-4 sm:p-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                    <div class="text-black">
                        <h3 class="text-lg lg:text-xl font-bold text-[#0f523d] mb-1 font-fredoka">Checkout item yang dicentang</h3>
                        <p class="text-slate-600 text-sm lg:text-base font-semibold leading-relaxed">
                            Jika item berasal dari beberapa toko, sistem akan membuat pesanan terpisah untuk tiap toko.
                        </p>
                    </div>

                    <button type="submit" form="checkoutForm" onclick="return confirm('Yakin ingin memesan semua produk yang dicentang? Saldo akan langsung dipotong.');" 
                            class="w-full sm:w-auto bg-[#00c851] hover:bg-[#007e33] text-white font-bold text-lg lg:text-xl px-8 py-4 rounded-[20px] shadow-md transition-all text-center whitespace-nowrap font-fredoka">
                        Pesan Sekarang
                    </button>
                </div>
            }

        </div>

        <div class="mt-12 pt-4 border-t border-slate-100 text-center text-xs text-slate-400">
            &copy; 2026 - SaungJajan
        </div>

    </div>

</body>
</html>