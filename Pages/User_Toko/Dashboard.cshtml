@page
@model SAUNGJAJAN.Pages.User_Toko.DashboardModel
@{
    ViewData["Title"] = "Dashboard Toko";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SaungJajan</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Fredoka', sans-serif;
        }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="bg-[#1f1f1f] min-h-screen flex items-center justify-center p-0 md:p-6 lg:p-8">

    <div class="w-full max-w-[450px] lg:max-w-[1200px] bg-white min-h-screen lg:min-h-[780px] lg:rounded-[40px] shadow-2xl overflow-hidden p-6 md:p-8 flex flex-col justify-between border-0 md:border-[8px] border-slate-800 transition-all duration-300">
        
        <div>
            <div class="flex items-center justify-between mb-6 border-b-2 border-slate-100 pb-4">
                <div>
                    <h1 class="text-4xl lg:text-5xl font-bold tracking-tight text-black">Saung Jajan</h1>
                    @if (Model.Toko != null)
                    {
                        <p class="text-lg lg:text-xl font-semibold text-slate-600 mt-1">@Model.Toko.NamaToko</p>
                    }
                </div>
                <a asp-page="/Auth/LogoutToko" class="bg-[#7371fc] text-black text-lg lg:text-xl font-bold px-6 py-2 rounded-2xl hover:bg-[#5b59e0] hover:text-white transition-colors border-2 border-black/10 shadow-sm">
                    Logout
                </a>
            </div>

            <div class="grid grid-cols-3 gap-2 mb-8 text-center border-b-2 border-slate-100">
                <a href="#" class="text-[#7371fc] text-2xl lg:text-3xl font-bold pb-3 border-b-4 border-[#7371fc]">Home</a>
                <a asp-page="/User_Toko/Produk" class="text-slate-400 hover:text-black text-2xl lg:text-3xl font-bold pb-3 transition-colors">Produk</a>
                <a asp-page="/User_Toko/LaporanPenjualan" class="text-slate-400 hover:text-black text-2xl lg:text-3xl font-bold pb-3 transition-colors">Laporan</a>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
            {
                <div class="mb-4 rounded-xl bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700 ring-1 ring-emerald-200">
                    @Model.SuccessMessage
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="mb-4 rounded-xl bg-red-50 px-4 py-3 text-sm font-medium text-red-700 ring-1 ring-red-200">
                    @Model.ErrorMessage
                </div>
            }

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                
                <div class="lg:col-span-7 space-y-6">
                    <div class="grid grid-cols-2 gap-4">
                        <div class="bg-[#7371fc] rounded-[28px] p-5 flex flex-col items-center justify-center shadow-md min-h-[140px] lg:min-h-[150px] border border-black/5">
                            <span class="text-5xl lg:text-6xl font-bold text-white mb-2 drop-shadow-sm">@Model.TotalProduk</span>
                            <span class="text-md lg:text-lg font-bold text-black/80 tracking-wide text-center">Total Produk</span>
                        </div>

                        <div class="bg-[#7371fc] rounded-[28px] p-5 flex flex-col items-center justify-center shadow-md min-h-[140px] lg:min-h-[150px] border border-black/5">
                            <span class="text-5xl lg:text-6xl font-bold text-white mb-2 drop-shadow-sm">@Model.TotalStok</span>
                            <span class="text-md lg:text-lg font-bold text-black/80 tracking-wide text-center">Total Stok</span>
                        </div>

                        <div class="bg-[#7371fc] rounded-[28px] p-5 flex flex-col items-center justify-center shadow-md min-h-[140px] lg:min-h-[150px] border border-black/5">
                            <span class="text-5xl lg:text-6xl font-bold text-white mb-2 drop-shadow-sm">@Model.TotalPesanan</span>
                            <span class="text-md lg:text-lg font-bold text-black/80 tracking-wide text-center">Pesanan Masuk</span>
                        </div>

                        <div class="bg-[#7371fc] rounded-[28px] p-5 flex flex-col items-center justify-center shadow-md min-h-[140px] lg:min-h-[150px] border border-black/5">
                            <span class="text-5xl lg:text-6xl font-bold text-white mb-2 drop-shadow-sm">@Model.TotalPenjualanToko.ToString("N0")</span>
                            <span class="text-md lg:text-lg font-bold text-black/80 tracking-wide text-center">Pendapatan</span>
                        </div>
                    </div>
                </div>

                <div class="lg:col-span-5 space-y-6">
                    <button type="button" onclick="if(window.innerWidth < 1024) document.getElementById('formInputProduk').classList.toggle('hidden')"
                            class="w-full bg-[#7371fc] text-black text-xl lg:text-2xl font-bold py-3.5 px-4 rounded-2xl shadow-md hover:bg-[#5b59e0] hover:text-white transition-all text-center block border border-black/10">
                        Tambah Produk
                    </button>

                    <div id="formInputProduk" class="bg-[#dcdcdc] rounded-[32px] overflow-hidden shadow-inner border border-slate-300 lg:block">
                        <div class="bg-[#7371fc] text-center py-3 border-b border-black/5">
                            <h2 class="text-3xl lg:text-4xl font-bold text-black tracking-wide">Tambah Produk</h2>
                        </div>
                        
                        <form method="post" asp-page-handler="TambahProduk" class="p-6 space-y-5">
                            <div class="flex items-center justify-between gap-4">
                                <label class="text-xl lg:text-2xl font-bold text-black min-w-[85px]">Nama:</label>
                                <input asp-for="ProdukInput.NamaMakanan" class="w-full bg-white rounded-xl py-2 px-4 text-lg border-none focus:outline-none focus:ring-4 focus:ring-[#7371fc]/50 shadow-sm transition-all" placeholder="Nama produk" />
                            </div>

                            <div class="flex items-center justify-between gap-4">
                                <label class="text-xl lg:text-2xl font-bold text-black min-w-[85px]">Jenis:</label>
                                <select asp-for="ProdukInput.Jenis" class="w-full bg-white rounded-xl py-2 px-4 text-lg border-none focus:outline-none focus:ring-4 focus:ring-[#7371fc]/50 shadow-sm transition-all">
                                    <option value="makanan">Makanan</option>
                                    <option value="minuman">Minuman</option>
                                </select>
                            </div>

                            <div class="flex items-center justify-between gap-4">
                                <label class="text-xl lg:text-2xl font-bold text-black min-w-[85px]">Harga:</label>
                                <input asp-for="ProdukInput.Harga" type="number" name="harga" class="w-full bg-white rounded-xl py-2 px-4 text-lg border-none focus:outline-none focus:ring-4 focus:ring-[#7371fc]/50 shadow-sm transition-all" placeholder="0" />
                            </div>

                            <div class="flex items-center justify-between gap-4">
                                <label class="text-xl lg:text-2xl font-bold text-black min-w-[85px]">Stok:</label>
                                <input asp-for="ProdukInput.Stok" type="number" name="stok" class="w-full bg-white rounded-xl py-2 px-4 text-lg border-none focus:outline-none focus:ring-4 focus:ring-[#7371fc]/50 shadow-sm transition-all" placeholder="0" />
                            </div>

                            <div class="pt-2">
                                <button type="submit" class="w-full bg-[#7371fc] text-black text-xl lg:text-2xl font-bold py-2.5 px-4 rounded-2xl hover:bg-[#5b59e0] hover:text-white transition-all shadow-md border border-black/10">
                                    Simpan
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

            </div>

            <!-- Pesanan Terbaru Section -->
            <div class="mt-10">
                <h3 class="text-3xl lg:text-4xl font-bold text-black mb-6 border-l-4 border-[#7371fc] pl-4">Pesanan Terbaru</h3>

                @if (!Model.PesananList.Any())
                {
                    <div class="bg-slate-50 rounded-2xl p-8 text-center">
                        <p class="text-slate-500 text-lg font-semibold">Belum ada pesanan masuk</p>
                    </div>
                }
                else
                {
                    <div class="space-y-4">
                        @foreach (var pesanan in Model.PesananList.Take(10))
                        {
                            <div class="bg-white rounded-2xl shadow-md border-2 border-slate-100 overflow-hidden">
                                <!-- Header Pesanan -->
                                <div class="bg-gradient-to-r from-[#7371fc] to-[#5b59e0] px-5 py-3 flex justify-between items-center">
                                    <div>
                                        <h4 class="text-white font-bold text-xl">Pesanan #@pesanan.IdPesanan</h4>
                                        <p class="text-white/80 text-sm font-semibold">@pesanan.NamaPemesan • @pesanan.WaktuPesan.ToString("dd MMM yyyy, HH:mm")</p>
                                    </div>
                                    <div class="text-right">
                                        @{
                                            var statusClass = pesanan.Status.ToLower() switch
                                            {
                                                "diproses" => "bg-yellow-400 text-yellow-900",
                                                "siap" => "bg-green-400 text-green-900",
                                                "dibatalkan" => "bg-red-400 text-red-900",
                                                _ => "bg-gray-400 text-gray-900"
                                            };
                                        }
                                        <span class="@(statusClass) text-sm font-bold px-4 py-1.5 rounded-full shadow-sm">
                                            @pesanan.Status
                                        </span>
                                    </div>
                                </div>

                                <!-- Detail Produk -->
                                <div class="p-5">
                                    <div class="space-y-2 mb-4">
                                        @foreach (var detail in pesanan.Detail)
                                        {
                                            <div class="flex justify-between items-center bg-slate-50 rounded-xl px-4 py-2">
                                                <div class="flex-1">
                                                    <span class="font-bold text-black text-lg">@detail.NamaProduk</span>
                                                    <span class="text-slate-500 text-sm ml-2">x@detail.Quantity</span>
                                                </div>
                                                <span class="font-bold text-[#7371fc] text-lg">Rp @detail.Subtotal.ToString("N0")</span>
                                            </div>
                                        }
                                    </div>

                                    <!-- Total dan Action Buttons -->
                                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pt-4 border-t-2 border-slate-100">
                                        <div>
                                            <p class="text-slate-600 text-sm font-semibold">Total Items: <span class="text-black">@pesanan.TotalItem</span></p>
                                            <p class="text-slate-600 text-sm font-semibold">Total: <span class="text-black text-xl font-bold">Rp @pesanan.TotalHargaToko.ToString("N0")</span></p>
                                        </div>

                                        @if (!pesanan.Status.Equals("Siap", StringComparison.OrdinalIgnoreCase) && 
                                               !pesanan.Status.Equals("Dibatalkan", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <div class="flex gap-2 w-full sm:w-auto">
                                                <form method="post" asp-page-handler="UpdateStatus" class="flex-1 sm:flex-none">
                                                    <input type="hidden" name="idPesanan" value="@pesanan.IdPesanan" />
                                                    <input type="hidden" name="status" value="Siap" />
                                                    <button type="submit" class="w-full bg-green-500 hover:bg-green-600 text-white font-bold px-5 py-2.5 rounded-xl transition-all shadow-sm text-sm">
                                                        ✓ Pesanan Siap
                                                    </button>
                                                </form>
                                                <form method="post" asp-page-handler="UpdateStatus" class="flex-1 sm:flex-none">
                                                    <input type="hidden" name="idPesanan" value="@pesanan.IdPesanan" />
                                                    <input type="hidden" name="status" value="Dibatalkan" />
                                                    <button type="submit" class="w-full bg-red-500 hover:bg-red-600 text-white font-bold px-5 py-2.5 rounded-xl transition-all shadow-sm text-sm" 
                                                            onclick="return confirm('Yakin ingin membatalkan pesanan ini?');">
                                                        ✕ Batalkan
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                        else if (pesanan.Status.Equals("Siap", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <div class="bg-green-50 border-2 border-green-200 rounded-xl px-4 py-2">
                                                <p class="text-green-700 font-bold text-sm">✓ Pesanan siap diambil</p>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

        </div>

        <div class="mt-12 pt-4 border-t border-slate-100 text-center text-xs text-slate-400">
            &copy; 2026 - SaungJajan
        </div>

    </div>

</body>
</html>