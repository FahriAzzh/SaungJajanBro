@page
@model SAUNGJAJAN.Pages.User_Toko.LaporanPenjualanModel
@{
    ViewData["Title"] = "Laporan Transaksi Penjualan";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SaungJajan</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Fredoka', sans-serif;
            background-color: #1f1f1f;
        }
        
        @@media print {
            .no-print {
                display: none !important;
            }
            body {
                background-color: white;
            }
            .main-container {
                padding: 0 !important;
                max-width: 100% !important;
                border: none !important;
                box-shadow: none !important;
            }
            .wrapper-box {
                border: 2px solid #000 !important;
                box-shadow: none !important;
                background: white !important;
            }
        }
    </style>
</head>
<body class="p-0 md:p-6 lg:p-8 flex items-center justify-center min-h-screen">

    <div class="main-container w-full max-w-[450px] lg:max-w-[1000px] bg-white min-h-screen lg:min-h-[780px] lg:rounded-[40px] shadow-2xl overflow-hidden p-6 md:p-8 flex flex-col justify-between border-0 md:border-[8px] border-slate-800 transition-all duration-300">
        
        <div>
            <div class="flex items-center justify-between mb-6 border-b-2 border-slate-100 pb-4">
                <div>
                    <h1 class="text-4xl lg:text-5xl font-bold tracking-tight text-black">Saung Jajan</h1>
                    @if (!string.IsNullOrEmpty(Model.NamaToko))
                    {
                        <p class="text-lg lg:text-xl font-semibold text-slate-600 mt-1">@Model.NamaToko</p>
                    }
                </div>
                <a asp-page="/Auth/LogoutToko" class="no-print bg-[#7371fc] text-black text-lg lg:text-xl font-bold px-6 py-2 rounded-2xl hover:bg-[#5b59e0] hover:text-white transition-colors border-2 border-black/10 shadow-sm">
                    Logout
                </a>
            </div>

            <div class="grid grid-cols-3 gap-2 mb-8 text-center border-b-2 border-slate-100">
                <a asp-page="/User_Toko/Dashboard" class="text-slate-400 hover:text-black text-2xl lg:text-3xl font-bold pb-3 transition-colors">Home</a>
                <a asp-page="/User_Toko/Produk" class="text-slate-400 hover:text-black text-2xl lg:text-3xl font-bold pb-3 transition-colors">Produk</a>
                <a href="#" class="text-[#7371fc] text-2xl lg:text-3xl font-bold pb-3 border-b-4 border-[#7371fc]">Laporan</a>
            </div>

            <div class="wrapper-box border-2 border-slate-300 rounded-[32px] p-4 sm:p-6 bg-white shadow-sm">
                
                <h2 class="text-2xl lg:text-4xl font-bold text-center tracking-wide text-black mb-6 mt-2">
                    LAPORAN TRANSAKSI PENJUALAN
                </h2>

                <div class="no-print flex flex-col sm:flex-row gap-4 justify-between items-center mb-6 bg-slate-50 p-4 rounded-2xl border border-slate-200">
                    <form method="get" class="flex items-center gap-3 w-full sm:w-auto">
                        <label class="font-bold text-slate-700 whitespace-nowrap text-base lg:text-lg">Periode:</label>
                        <input type="month" name="Bulan" value="@Model.Bulan" class="border-2 border-slate-300 rounded-xl px-3 py-1.5 text-base bg-white focus:outline-none focus:ring-4 focus:ring-[#7371fc]/30 w-full sm:w-auto text-center font-semibold" />
                        <button type="submit" class="bg-[#7371fc] hover:bg-[#5b59e0] text-white font-bold px-5 py-2 rounded-xl text-sm lg:text-base shadow-sm transition-all border border-black/5">
                            Filter
                        </button>
                    </form>
                    <div class="flex gap-3 w-full sm:w-auto justify-end">
                        <button onclick="window.print()" class="bg-red-400 hover:bg-red-500 text-white hover:text-white font-bold px-5 py-2.5 rounded-xl text-sm lg:text-base shadow-sm transition-all border border-black/5 w-full sm:w-auto">
                            Cetak/Simpan PDF
                        </button>
                        <a asp-page="/User_Toko/Dashboard" class="bg-[#7371fc] hover:bg-[#5b59e0] text-white hover:text-white font-bold px-5 py-2.5 rounded-xl text-sm lg:text-base shadow-sm transition-all border border-black/5 text-center w-full sm:w-auto">
                            Kembali ke Menu
                        </a>
                    </div>
                </div>

                <div class="border-2 border-slate-300 rounded-2xl p-4 mb-6 flex flex-col sm:flex-row sm:gap-12 text-lg lg:text-xl font-semibold text-black">
                    <div>Nama Toko: <span class="text-slate-700 ml-1">@Model.NamaToko</span></div>
                    <div>Periode: <span class="text-slate-700 ml-1">@Model.PeriodeText</span></div>
                </div>

                <div class="overflow-x-auto no-scrollbar">
                    <table class="w-full text-left border-collapse min-w-[650px] text-base lg:text-lg font-semibold text-black">
                        <thead>
                            <tr class="border-b-2 border-slate-200 text-center text-slate-500">
                                <th class="py-3 px-2 font-bold">No. Pesanan</th>
                                <th class="py-3 px-2 font-bold text-left">Pembeli</th>
                                <th class="py-3 px-2 font-bold">Waktu Pesan</th>
                                <th class="py-3 px-2 font-bold text-right">Total</th>
                                <th class="py-3 px-2 font-bold">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @if (!Model.LaporanList.Any())
                            {
                                <tr>
                                    <td colspan="5" class="py-10 text-center text-slate-400">
                                        Tidak ada transaksi pada periode ini.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model.LaporanList)
                                {
                                    <tr class="align-middle">
                                        <td class="py-4 px-2 text-center text-slate-600">#@item.IdPesanan</td>
                                        <td class="py-4 px-2 font-bold">@item.NamaPembeli</td>
                                        <td class="py-4 px-2 text-center text-slate-500">@item.WaktuPesan.ToString("dd MMM yyyy HH.mm")</td>
                                        <td class="py-4 px-2 text-right">Rp @item.Total.ToString("N0")</td>
                                        <td class="py-4 px-2 text-center">
                                            @{
                                                var statusClass = item.Status switch
                                                {
                                                    "Diproses" => "bg-green-100 text-green-700",
                                                    "Siap" => "bg-blue-100 text-blue-700",
                                                    "Dibatalkan" => "bg-red-100 text-red-600",
                                                    _ => "bg-gray-100 text-gray-700"
                                                };
                                            }
                                            <span class="@statusClass italic px-4 py-1 rounded-full text-sm inline-block w-28 font-semibold text-center">@item.Status</span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-6 bg-[#e6f9f3] border-2 border-[#ccf2e6] rounded-2xl p-4 sm:p-5 flex justify-between items-center text-[#0f523d] text-xl lg:text-3xl font-bold tracking-wide">
                    <span>Total Pendapatan:</span>
                    <span>Rp @Model.TotalPendapatan.ToString("N0")</span>
                </div>

            </div>
        </div>

        <div class="mt-12 pt-4 border-t border-slate-100 text-center text-xs text-slate-400">
            &copy; 2026 - SaungJajan
        </div>

    </div>

</body>
</html>